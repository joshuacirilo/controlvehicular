{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App movil - Flutter Web",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/appmovil",
      "program": "${workspaceFolder}/appmovil/lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port",
        "8080",
        "--dart-define=API_BASE_URL=http://localhost:3000/api/"
      ]
    }
  ]
}
