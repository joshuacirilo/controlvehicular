# Server only. Copy to .env.local and supply your own Atlas URI.
MONGODB_URI=
MONGODB_DB=trucks_db

# Random secret of at least 32 characters used to sign driver session tokens.
AUTH_SECRET=

# Comma-separated browser origins; localhost defaults only in development.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# EmailJS REST: server only. Never prefix these with NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_NOTIFICATION_TEMPLATE_ID=
EMAILJS_EMERGENCY_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
NEXT_PUBLIC_APP_URL=https://controlvehicular-owwh.vercel.app
