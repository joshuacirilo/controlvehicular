# Server only. Copy to .env.local and supply your own Atlas URI.
MONGODB_URI=
MONGODB_DB=trucks_db

# Random secret of at least 32 characters used to sign driver session tokens.
AUTH_SECRET=

# Comma-separated browser origins; localhost defaults only in development.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
